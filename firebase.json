{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/r/**",
        "function": "affiliateRedirect"
      },
      {
        "source": "/api/claim-start",
        "function": "claimStart"
      },
      {
        "source": "/api/travelpayouts-postback",
        "function": "travelpayoutsPostback"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  }
}
