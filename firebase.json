{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/r/nordvpn",
        "destination": "/nordvpn/quiz",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/track-quiz-event",
        "function": "trackQuizEvent"
      },
      {
        "source": "/api/nordvpn-webhook",
        "function": "nordVpnWebhook"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  }
}
