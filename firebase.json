{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/nordvpn/quiz/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/nordvpn/scan/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/nordvpn/quiz",
        "destination": "/nordvpn/quiz/index.html"
      },
      {
        "source": "/nordvpn/scan",
        "destination": "/nordvpn/scan/index.html"
      },
      {
        "source": "/api/telemetry",
        "function": "getIpTelemetry"
      },
      {
        "source": "/api/track-quiz-event",
        "function": "trackQuizEvent"
      },
      {
        "source": "/api/nordvpn-webhook",
        "function": "nordVpnWebhook"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  }
}
